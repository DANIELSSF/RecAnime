# Copy to infra/gcp/.env.deploy (gitignored) and fill in. Sourced by the infra/gcp scripts.
# Values are shell-quoted on load, so keep comments on their own lines.

# Personal Google account that owns the RecAnime GCP project. No default on purpose:
# the default gcloud configuration on this Mac belongs to a work account.
GCP_ACCOUNT=
# GCP project id (see docs/runbook.md step 4). May be left empty when the `recanime`
# gcloud configuration already has it set; if both exist they must match.
GCP_PROJECT=
# Cloud Run region. Create the Supabase project in the matching region (East US).
GCP_REGION=us-east1
# Cloud Run service name; also the runtime service account id.
CLOUD_RUN_SERVICE=recanime-api
# Supabase project ref (the <ref> in https://<ref>.supabase.co), used for JWKS verification.
SUPABASE_PROJECT_REF=
# Comma-separated list of the emails allowed to sign in.
AUTH_ALLOWED_EMAILS=
