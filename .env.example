# Copy to .env for local development. Never commit .env.

# --- server ---
PORT=8080
HOST=0.0.0.0                        # 0.0.0.0 so a physical iPhone/Watch on the LAN can reach the API
APP_ENV=development                 # development | production
LOG_LEVEL=debug

# --- database (local Docker; see docker-compose.yml) ---
DATABASE_URL=postgres://recanime:recanime@127.0.0.1:5433/recanime?sslmode=disable
DB_MAX_CONNS=4
DB_MIGRATE_ON_START=true
DB_SESSION_LOCK=true                # false only when using the Supavisor transaction pooler (port 6543)

# --- auth (Supabase) ---
SUPABASE_PROJECT_REF=               # e.g. abcdefghijklmnop -> JWKS at https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
AUTH_ALLOWED_EMAILS=                # comma-separated, case-insensitive; REQUIRED in production
DEV_BYPASS_AUTH=false               # development only: skips JWT verification and uses DEV_BYPASS_EMAIL
DEV_BYPASS_EMAIL=dev@example.com

# --- Jikan ---
JIKAN_BASE_URL=https://api.jikan.moe/v4
JIKAN_RPS=3
JIKAN_RPM=60

# --- cache policy ---
CACHE_TTL=12h                       # anime detail, top, seasons, schedules, episodes, per-anime recommendations
SEARCH_TTL=12h
LIVE_DEBOUNCE=30s                   # in-memory micro-cache for the live recommendations feed; 0 disables
FRANCHISE_FETCH_BUDGET=4            # max extra Jikan calls per /franchise request
