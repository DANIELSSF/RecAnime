# Copy to .env for local development. Never commit .env.
# Docker's --env-file does not support inline comments: keep comments on their own lines.

# --- server ---
PORT=8080
# empty = all interfaces (IPv4 + IPv6) so devices on the LAN and .local names work; 127.0.0.1 to stay private
HOST=
# development | production
APP_ENV=development
LOG_LEVEL=debug

# --- database (local Docker; see docker-compose.yml) ---
DATABASE_URL=postgres://recanime:recanime@127.0.0.1:5433/recanime?sslmode=disable
DB_MAX_CONNS=4
DB_MIGRATE_ON_START=true
# false only when using the Supavisor transaction pooler (port 6543)
DB_SESSION_LOCK=true

# --- auth (Supabase) ---
# e.g. abcdefghijklmnop -> JWKS at https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PROJECT_REF=
# comma-separated, case-insensitive; REQUIRED in production
AUTH_ALLOWED_EMAILS=
# development only: skips JWT verification and uses DEV_BYPASS_EMAIL
DEV_BYPASS_AUTH=false
DEV_BYPASS_EMAIL=dev@example.com

# --- Jikan ---
JIKAN_BASE_URL=https://api.jikan.moe/v4
JIKAN_RPS=3
JIKAN_RPM=60

# --- cache policy ---
# anime detail, top, seasons, schedules, episodes, per-anime recommendations
CACHE_TTL=12h
SEARCH_TTL=12h
# in-memory micro-cache for the live recommendations feed; 0 disables
LIVE_DEBOUNCE=30s
# max extra Jikan calls per /franchise request
FRANCHISE_FETCH_BUDGET=4
# max upstream episode fetches per /v1/me/schedule?includeEpisodes=true request; 0 disables them
SCHEDULE_EPISODE_BUDGET=6
# list_cache rows older than this are swept every 6 h; 0 disables the sweep
LIST_CACHE_RETENTION=168h
