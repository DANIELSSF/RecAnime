// Copy to Secrets.xcconfig (gitignored). These are public identifiers, but they stay out of git anyway.
SUPABASE_URL = https:/$()/<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_xxx
GOOGLE_IOS_CLIENT_ID = 1234567890-abc.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID = 1234567890-def.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.1234567890-abc
// Cloud Run URL of the API, printed by infra/gcp/deploy.sh. Used by Release builds only
// (the sideload configuration); Debug reads API_BASE_URL from Debug/Local.xcconfig.
API_BASE_URL_RELEASE = https:/$()/recanime-api-xxxx-ue.a.run.app
